@model ReservationMVC.Models.Offer
@{
    ViewData["Title"] = "Modifier une offre";
    var categories = ViewBag.AllowedCategories as string[] ?? Array.Empty<string>();
}

<a asp-action="MyOffers" class="btn btn-outline-secondary btn-sm mb-3">⬅ Retour à mes offres</a>
<h1>Modifier l’offre</h1>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Titre</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Catégorie</label>
        <select asp-for="Category" class="form-select">
            @foreach (var c in categories)
            {
                <option value="@c" selected="@(c == Model.Category ? "selected" : null)">@c</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Lieu</label>
        <input asp-for="Location" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Prix</label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label class="form-label">Image (URL)</label>
        <input asp-for="ImageUrl" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Enregistrer</button>
</form>
