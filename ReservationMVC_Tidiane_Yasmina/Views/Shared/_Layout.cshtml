@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    bool isProvider = User?.Claims?.Any(c => c.Type == "app:role" && c.Value == "Provider") ?? false;
    bool isClient = isAuth && !isProvider;

    var displayName = User?.Claims?.FirstOrDefault(c => c.Type == "FullName")?.Value
                      ?? User?.Identity?.Name ?? "Utilisateur";

    var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLowerInvariant();
    var showPayment = currentController is "cart" or "orders";
}

<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ReservationMVC</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-dark bg-dark navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">ReservationMVC</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topnav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="topnav">
                <ul class="navbar-nav me-auto"></ul>
                <ul class="navbar-nav align-items-center gap-2">

                    @* Panier visible seulement pour le client *@
                    @if (isClient)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Cart" asp-action="Index">Panier</a>
                        </li>
                    }

                    @if (isAuth)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#">Profil</a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Profiles" asp-action="Profile">Mon profil</a></li>
                                <li><hr class="dropdown-divider" /></li>

                                @if (isProvider)
                                {
                                    <li><a class="dropdown-item" asp-controller="Offers" asp-action="MyOffers">Gérer mes offres</a></li>
                                    <li><a class="dropdown-item" asp-controller="Offers" asp-action="Create">Publier une offre</a></li>
                                    <li><a class="dropdown-item" asp-controller="Profiles" asp-action="ProviderDashboard">Tableau de bord fournisseur</a></li>
                                }
                                else if (isClient)
                                {
                                    <li><a class="dropdown-item" asp-controller="Profiles" asp-action="ClientDashboard">Tableau de bord client</a></li>
                                }
                            </ul>
                        </li>

                        <li class="navbar-text text-white-50">Bienvenue, @displayName</li>
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Logout">Déconnexion</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Connexion</a></li>
                        <li class="nav-item"><a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Register">Inscription</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-3">
        @if (TempData["Msg"] is string msg && !string.IsNullOrWhiteSpace(msg))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @msg
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
