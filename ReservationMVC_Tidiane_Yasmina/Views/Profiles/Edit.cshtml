@model ReservationMVC.Models.ProfileEditVm
@{
    ViewData["Title"] = "Modifier mon profil";
}

<h1 class="mb-4">Modifier mon profil</h1>

<div class="row">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" readonly />
                        <div class="form-text">L’adresse e-mail ne peut pas être modifiée ici.</div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-primary" type="submit">💾 Enregistrer</button>
                        <a asp-action="Profile" class="btn btn-outline-secondary">⬅ Retour</a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">🏠 Accueil</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
